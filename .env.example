MODEL_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
APP_TIMEZONE=Asia/Kolkata
DATABASE_PATH=data/decision_lock.db
REQUEST_TIMEOUT_SECONDS=180
MAX_MODEL_CALLS=8
RUN_LIVE_TESTS=false

# Set GEMINI_API_KEY privately in the process environment.
# GOOGLE_API_KEY is also supported; GEMINI_API_KEY takes precedence.
# The Windows launcher can keep a user-encrypted key in .gemini-key.dpapi.
# Do not publish an API key, a private .env, or the encrypted key file.
